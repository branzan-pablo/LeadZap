# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Evolution API
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
# URL do app visível PELO container Docker da Evolution (dev local: host.docker.internal)
# Produção: URL pública do app (ex: https://app.leadzap.com.br)
EVOLUTION_WEBHOOK_CALLBACK_URL=http://host.docker.internal:3000

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required: protects POST /api/push/send (fail-closed without it)
PUSH_SEND_SECRET=

# Vercel Cron: same value as CRON_SECRET in Vercel project settings
CRON_SECRET=
